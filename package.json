{
  "name": "meetlite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @meetlite/server\" \"npm run dev -w @meetlite/web\"",
    "build": "npm run build -w @meetlite/server && npm run build -w @meetlite/web",
    "start": "npm run start -w @meetlite/server",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
