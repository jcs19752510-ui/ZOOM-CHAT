# MeetLite 서버 환경변수 예시. 복사해서 .env로 만들고 값을 채우세요. .env는 커밋하지 않습니다.
# 비밀값(SESSION_SECRET, TURN_SECRET)은 `openssl rand -base64 48` 등으로 만든 긴 난수를 쓰세요.

NODE_ENV=development
PORT=3001

# 허용할 웹 Origin(쉼표로 여러 개). 와일드카드(*) 금지. 운영에서는 실제 https 주소.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# 세션 토큰·호스트 클레임 서명용 비밀값(32자 이상, 필수)
SESSION_SECRET=change-me-change-me-change-me-change-me

# STUN(쉼표로 여러 개). 기본값은 공개 STUN 서버입니다(제3자 서버, 개인정보 문서 참고).
STUN_URLS=stun:stun.l.google.com:19302

# TURN(선택). 직접 연결이 안 되는 네트워크를 위해 coturn을 쓸 때만 설정합니다.
# TURN_URLS=turn:localhost:3478,turn:localhost:3478?transport=tcp
# TURN_SECRET=change-me-turn-secret-change-me
TURN_TTL_SEC=3600

# 서비스 한도
MAX_PARTICIPANTS=6
MAX_ROOMS=100
ROOM_EMPTY_TTL_MIN=10
RECONNECT_GRACE_SEC=20
IP_MAX_CONNECTIONS=20

# 리버스 프록시 뒤에서 실행할 때 프록시 단계 수(직접 노출이면 0)
TRUST_PROXY=0

LOG_LEVEL=info

# 서버가 웹 빌드 결과를 함께 제공하려면 경로를 지정(예: apps/web/dist). 개발 중에는 비워 둡니다.
# WEB_DIST=apps/web/dist
